@article{WANG2026119319,
	title = {Multi-Source Structural Fusion and Synchronous Heterogeneous Network for Power Transformers Partial Domain Adaptation Fault Diagnosis},
	author = {Wang, Wenyu and Liu, Fuzheng and Lv, Xuebin and Zhang, Faye and Jiang, Mingshun and Jia, Yingzhe},
	year = 2026,
	journal = {Measurement},
	volume = {258},
	pages = {119319},
	issn = {0263-2241},
	doi = {10.1016/j.measurement.2025.119319},
	abstract = {In the intelligent operation and maintenance of electrical equipment, vibration signal-driven cross-domain fault diagnosis for power transformers faces two major challenges: practical scenarios often involve a target domain containing only a subset of fault types from the source domain, and target domain samples are typically unlabeled. To address these issues, this study proposes a multi-source structural fusion and synchronous heterogeneous network (MS-FSHN). The framework establishes a dual-terminal learning architecture: the source terminal employs multi-source feature fusion with an optimal transport metric gate (OTMG) to dynamically construct a cross-domain feature space adapted to the target fault subset, while the target terminal designs a parallel time--frequency feature extractor to achieve cross-modal alignment through dynamic weighted adversarial learning. Experiments conducted on a \textpm 110 kV three-phase transformer vibration platform collecting three typical fault types demonstrate an online recognition accuracy of 98.3},
	keywords = {Intelligent fault diagnosis,Multi-source domain,Partial domain,Power transformer}
}

