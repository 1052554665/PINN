clc; clear; close all;

%% 1. 离散正弦信号（每周期 8 点）
p = 8;              % 每周期 8 点
NC = 4;        % 需要 4 个周期
N = p * NC; % 信号总长度 = 32 点

n = 0:N-1;
x = sin(2*pi*(1/p)*n);   % 频率对应每 8 点一个周期

%% 2. Hamming 窗（长度为 32 点）
w = hamming(N).';

%% 3. 信号 × 窗函数
xw = x .* w;

%% 4. 绘图
figure;

subplot(3,1,1);
% stem(n, x, 'filled');
title("离散正弦信号（每周期 8 点，4 个周期）");
xlabel("n"); ylabel("x[n]"); grid on;

subplot(3,1,2);
stem(n, w, 'filled');
title("Hamming 窗（长度 = 32）");
xlabel("n"); ylabel("w[n]"); grid on;

subplot(3,1,3);
stem(n, xw, 'filled');
title("加窗后的信号 x[n] w[n]");
xlabel("n"); ylabel("x[n]w[n]"); grid on;
